  "9a16ef078381381629e36e3ea5dc91b96863649acb660b32ed73769da747e2eb": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mo stretchy=\"false\">[</mo><msub><mi>z</mi><mn>1</mn></msub><mo separator=\"true\">,</mo><msub><mi>z</mi><mn>2</mn></msub><mo separator=\"true\">;</mo><msub><mi>z</mi><mn>3</mn></msub><mo separator=\"true\">,</mo><msub><mi>z</mi><mn>4</mn></msub><mo stretchy=\"false\">]</mo><mo>=</mo><mfrac><mrow><mo stretchy=\"false\">(</mo><msub><mi>z</mi><mn>3</mn></msub><mo>−</mo><msub><mi>z</mi><mn>1</mn></msub><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><msub><mi>z</mi><mn>4</mn></msub><mo>−</mo><msub><mi>z</mi><mn>2</mn></msub><mo stretchy=\"false\">)</mo></mrow><mrow><mo stretchy=\"false\">(</mo><msub><mi>z</mi><mn>3</mn></msub><mo>−</mo><msub><mi>z</mi><mn>2</mn></msub><mo stretchy=\"false\">)</mo><mo stretchy=\"false\">(</mo><msub><mi>z</mi><mn>4</mn></msub><mo>−</mo><msub><mi>z</mi><mn>1</mn></msub><mo stretchy=\"false\">)</mo></mrow></mfrac><mi mathvariant=\"normal\">.</mi></mrow><annotation encoding=\"application/x-tex\">[z_1,z_2;z_3,z_4]\n=\\frac{(z_3-z_1)(z_4-z_2)}{(z_3-z_2)(z_4-z_1)}.</annotation></semantics></math></span>",
  "75e208676c0ae8fbe924d2fd3ab177ab440fc1d5d6b902a3f1545a631007b7ac": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>u</mi><mi>v</mi><mo>=</mo><mfrac><msup><mi>x</mi><mn>2</mn></msup><mrow><mn>1</mn><mo>−</mo><msup><mi>y</mi><mn>2</mn></msup></mrow></mfrac><mo>=</mo><mn>1</mn><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi>v</mi><mo>=</mo><mfrac><mn>1</mn><mi>u</mi></mfrac><mi mathvariant=\"normal\">.</mi></mrow><annotation encoding=\"application/x-tex\">uv=\\frac{x^2}{1-y^2}=1,\n\\qquad v=\\frac1u.</annotation></semantics></math></span>",
  "0b625861e9e82b4f85e5e83bfa3df330175ebd031f1e5c0aa8e54d6a6a2a39bb": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mi>y</mi><mo>=</mo><mfrac><mrow><msup><mi>u</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn></mrow><mrow><msup><mi>u</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mfrac><mrow><mn>1</mn><mo>−</mo><msup><mi>v</mi><mn>2</mn></msup></mrow><mrow><mn>1</mn><mo>+</mo><msup><mi>v</mi><mn>2</mn></msup></mrow></mfrac><mi mathvariant=\"normal\">.</mi></mrow><annotation encoding=\"application/x-tex\">y=\\frac{u^2-1}{u^2+1}\n  =\\frac{1-v^2}{1+v^2}.</annotation></semantics></math></span>",
  "1d546a7908bd721549be43e9c34ffacc2dd6fc325c16b7ddb35bf2622f98d5c2": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mo stretchy=\"false\">(</mo><mi>x</mi><mo separator=\"true\">,</mo><mi>y</mi><mo stretchy=\"false\">)</mo><mo>∼</mo><mo stretchy=\"false\">(</mo><mi>x</mi><mo>+</mo><mi>m</mi><mo separator=\"true\">,</mo><mi>y</mi><mo>+</mo><mi>n</mi><mo stretchy=\"false\">)</mo><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mi>m</mi><mo separator=\"true\">,</mo><mi>n</mi><mo>∈</mo><mi mathvariant=\"double-struck\">Z</mi><mi mathvariant=\"normal\">.</mi></mrow><annotation encoding=\"application/x-tex\">(x,y)\\sim(x+m,y+n),\\qquad m,n\\in\\mathbb Z.</annotation></semantics></math></span>",
  "6596c5d7b342e484da5e61d491e1361eae713ecc2d6f70ff10a744ddd78a821e": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mfrac><mn>4</mn><mn>3</mn></mfrac><mtext>  </mtext><mfrac><mn>9</mn><mn>8</mn></mfrac><mtext>  </mtext><mfrac><mn>4</mn><mn>3</mn></mfrac><mo>=</mo><mn>2</mn><mo separator=\"true\">,</mo><mspace width=\"2em\"/><mfrac><mn>16</mn><mn>9</mn></mfrac><mtext>  </mtext><mfrac><mn>9</mn><mn>8</mn></mfrac><mo>=</mo><mn>2.</mn></mrow><annotation encoding=\"application/x-tex\">\\frac43\\;\\frac98\\;\\frac43=2,\n\\qquad\n\\frac{16}{9}\\;\\frac98=2.</annotation></semantics></math></span>",
