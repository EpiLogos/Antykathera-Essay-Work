  "6b1213cac1c2bc1868ff9635bcc7058ef4d21cd1fd2ec63c751dab3b8bc13c5b": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mn>0</mn><mi mathvariant=\"normal\">/</mi><mn>1</mn><mtext>  </mtext><mo>⟶</mo><mtext>  </mtext><mn>4</mn><mo>+</mo><mn>2</mn><mtext>  </mtext><mo>⟶</mo><mtext>  </mtext><mo stretchy=\"false\">(</mo><mn>5</mn><mtext> ⁣</mtext><mo>→</mo><mtext> ⁣</mtext><mn>0</mn><mo stretchy=\"false\">)</mo><mtext>  </mtext><mo>⟶</mo><mtext>  </mtext><mn>0</mn><mi mathvariant=\"normal\">/</mi><mn>1.</mn></mrow><annotation encoding=\"application/x-tex\">0/1\\;\\longrightarrow\\;4+2\\;\\longrightarrow\\;(5\\!\\to\\!0)\\;\\longrightarrow\\;0/1.</annotation></semantics></math></span>",
  "4292211c0e946d4f38d72e88d87187c54a316831926114be04253b889d149ca3": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mn>0</mn><mi mathvariant=\"normal\">/</mi><mn>1</mn><mo>→</mo><mn>4</mn><mo>+</mo><mn>2</mn><mo>→</mo><mo stretchy=\"false\">(</mo><mn>5</mn><mo>→</mo><mn>0</mn><mo stretchy=\"false\">)</mo><mo>→</mo><mn>1</mn><mi mathvariant=\"normal\">/</mi><mn>0</mn><mo>→</mo><msup><mn>4</mn><mo mathvariant=\"normal\" lspace=\"0em\" rspace=\"0em\">′</mo></msup><mo>+</mo><msup><mn>2</mn><mo mathvariant=\"normal\" lspace=\"0em\" rspace=\"0em\">′</mo></msup><mo>→</mo><mo stretchy=\"false\">(</mo><msup><mn>5</mn><mo mathvariant=\"normal\" lspace=\"0em\" rspace=\"0em\">′</mo></msup><mo>→</mo><msup><mn>0</mn><mo mathvariant=\"normal\" lspace=\"0em\" rspace=\"0em\">′</mo></msup><mo stretchy=\"false\">)</mo><mo>→</mo><mn>0</mn><mi mathvariant=\"normal\">/</mi><mn>1.</mn></mrow><annotation encoding=\"application/x-tex\">0/1\\to4+2\\to(5\\to0)\\to1/0\\to4&#x27;+2&#x27;\\to(5&#x27;\\to0&#x27;)\\to0/1.</annotation></semantics></math></span>",
  "4f7c65e9109fcf0b724db619b2d88facfe3a395a2fdc68be6ad730139ccb9a2f": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mfrac><mrow><mi>cos</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mi>δ</mi><mi mathvariant=\"normal\">/</mi><mn>2</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mi>i</mi><mi>sin</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mi>δ</mi><mi mathvariant=\"normal\">/</mi><mn>2</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mi>cos</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mi>δ</mi><mi mathvariant=\"normal\">/</mi><mn>2</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mi>i</mi><mi>sin</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mi>δ</mi><mi mathvariant=\"normal\">/</mi><mn>2</mn><mo stretchy=\"false\">)</mo></mrow></mfrac><mo>=</mo><msup><mi>e</mi><mrow><mi>i</mi><mi>δ</mi></mrow></msup><mi mathvariant=\"normal\">.</mi></mrow><annotation encoding=\"application/x-tex\">\\frac{\\cos(\\delta/2)+i\\sin(\\delta/2)}\n     {\\cos(\\delta/2)-i\\sin(\\delta/2)}\n= e^{i\\delta}.</annotation></semantics></math></span>",
  "a3542eec8460f9c4b3336654c2b6aa97f6b1fde5c2eb8b3c7890ca9ce6f0aa06": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><msup><mi>π</mi><mo lspace=\"0em\" rspace=\"0em\">∗</mo></msup><mo stretchy=\"false\">(</mo><mi>y</mi><mo>∣</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mo>∝</mo><msub><mi>π</mi><mrow><mi mathvariant=\"normal\">r</mi><mi mathvariant=\"normal\">e</mi><mi mathvariant=\"normal\">f</mi></mrow></msub><mo stretchy=\"false\">(</mo><mi>y</mi><mo>∣</mo><mi>x</mi><mo stretchy=\"false\">)</mo><mi>exp</mi><mo>⁡</mo><mtext> ⁣</mtext><mrow><mo fence=\"true\">(</mo><mi>r</mi><mo stretchy=\"false\">(</mo><mi>x</mi><mo separator=\"true\">,</mo><mi>y</mi><mo stretchy=\"false\">)</mo><mi mathvariant=\"normal\">/</mi><mi>β</mi><mo fence=\"true\">)</mo></mrow><mi mathvariant=\"normal\">.</mi></mrow><annotation encoding=\"application/x-tex\">\\pi^{*}(y\\mid x)\\propto\\pi_{\\mathrm{ref}}(y\\mid x)\\exp\\!\\left(r(x,y)/\\beta\\right).</annotation></semantics></math></span>",
  "2906851d7586dd0fe20236a834171aa20b948c323e6df3b43740d04fd1a9ebcd": "<span class=\"katex\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mrow><mfrac><mrow><mi>cos</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mi>δ</mi><mi mathvariant=\"normal\">/</mi><mn>2</mn><mo stretchy=\"false\">)</mo><mo>+</mo><mi>i</mi><mi>sin</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mi>δ</mi><mi mathvariant=\"normal\">/</mi><mn>2</mn><mo stretchy=\"false\">)</mo></mrow><mrow><mi>cos</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mi>δ</mi><mi mathvariant=\"normal\">/</mi><mn>2</mn><mo stretchy=\"false\">)</mo><mo>−</mo><mi>i</mi><mi>sin</mi><mo>⁡</mo><mo stretchy=\"false\">(</mo><mi>δ</mi><mi mathvariant=\"normal\">/</mi><mn>2</mn><mo stretchy=\"false\">)</mo></mrow></mfrac><mo>=</mo><mfrac><msup><mi>e</mi><mrow><mi>i</mi><mi>δ</mi><mi mathvariant=\"normal\">/</mi><mn>2</mn></mrow></msup><msup><mi>e</mi><mrow><mo>−</mo><mi>i</mi><mi>δ</mi><mi mathvariant=\"normal\">/</mi><mn>2</mn></mrow></msup></mfrac><mo>=</mo><msup><mi>e</mi><mrow><mi>i</mi><mi>δ</mi></mrow></msup><mi mathvariant=\"normal\">.</mi></mrow><annotation encoding=\"application/x-tex\">\\frac{\\cos(\\delta/2)+i\\sin(\\delta/2)}\n     {\\cos(\\delta/2)-i\\sin(\\delta/2)}\n=\\frac{e^{i\\delta/2}}{e^{-i\\delta/2}}\n=e^{i\\delta}.</annotation></semantics></math></span>"
