    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "pixel_aspect",
        "safe_area"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "pixel_aspect": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "safe_area": {
          "type": "object"
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fps_num",
        "fps_den",
        "duration_frames"
      ],
      "properties": {
        "fps_num": {
          "type": "integer",
          "minimum": 1
        },
        "fps_den": {
          "type": "integer",
          "minimum": 1
        },
        "duration_frames": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scene_pairs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pair_index",
          "addresses",
          "start_frame",
          "duration_frames",
          "reciprocity_mode"
        ],
        "properties": {
          "pair_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "addresses": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "enum": [
                "P0",
                "P1",
                "P2",
                "P3",
                "P4",
                "P5",
                "P0′",
                "P1′",
                "P2′",
                "P3′",
                "P4′",
                "P5′"
