          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1
          },
          "reciprocity_mode": {
            "enum": [
              "phase_flip",
              "crossfade",
              "interleaved",
              "split_field",
              "masked_reveal",
              "conjugate_cut",
              "audio_visual_exchange"
