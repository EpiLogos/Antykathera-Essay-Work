  "title": "Epi-Card Deterministic Render Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "engagement_id",
    "profile",
    "canvas",
    "timeline",
    "scene_pairs",
    "scene_atoms",
    "layers",
    "audio",
