          },
          "start_frame": {
            "type": "integer",
            "minimum": 0
          },
          "duration_frames": {
            "type": "integer",
            "minimum": 1
          },
          "source": {
            "type": "object"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_rate",
        "channels",
        "master_asset_id",
        "mix_plan"
      ],
      "properties": {
        "sample_rate": {
          "type": "integer",
          "minimum": 8000
        },
        "channels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "master_asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "mix_plan": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "first_anchor",
        "last_anchor",
        "max_visual_delta",
        "max_audio_discontinuity_db",
        "semantic_delta_required"
      ],
      "properties": {
        "enabled": {
          "const": true
        },
        "first_anchor": {
          "type": "object"
        },
        "last_anchor": {
          "type": "object"
        },
        "max_visual_delta": {
          "type": "number",
          "minimum": 0
        },
        "max_audio_discontinuity_db": {
          "type": "number",
          "minimum": 0
        },
        "semantic_delta_required": {
          "const": true
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "container",
          "video_codec",
          "audio_codec",
          "width",
          "height",
          "alpha"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "container": {
            "enum": [
              "mp4",
              "webm",
              "mov",
              "gif",
              "png",
              "webp",
              "pdf",
              "wav",
              "flac",
              "opus"
            ]
          },
          "video_codec": {
            "type": [
              "string",
              "null"
            ]
          },
          "audio_codec": {
            "type": [
              "string",
              "null"
            ]
          },
          "width": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "height": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "alpha": {
            "type": "boolean"
          },
          "settings": {
            "type": "object"
          }
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "ffmpeg_version",
        "composition_id"
      ],
      "properties": {
        "name": {
          "const": "remotion"
        },
        "version": {
          "type": "string"
        },
        "ffmpeg_version": {
          "type": "string"
        },
        "composition_id": {
          "type": "string"
        }
      }
    }
  }
}
