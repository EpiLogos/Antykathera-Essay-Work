{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://epi-logos.dev/schemas/epi-card/action-envelope-1.0.0.schema.json",
  "title": "Epi-Card Action Invocation and Result Envelope",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent",
            "service"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "harness": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "action",
        "action_version",
        "request_id",
        "idempotency_key",
        "actor",
        "input",
        "options"
      ],
      "properties": {
        "kind": {
          "const": "request"
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
        },
        "action_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "engagement_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "input": {
          "type": "object"
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dry_run",
            "approval_mode"
          ],
          "properties": {
            "dry_run": {
              "type": "boolean"
            },
            "approval_mode": {
              "enum": [
                "required-when-declared",
                "always",
                "never"
              ]
            },
            "wait": {
              "type": "boolean"
            },
            "resume_run_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            }
          }
        }
      }
    },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "media_type",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "media_type": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "uri": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "request_id",
        "action",
        "status",
        "assets",
        "warnings",
        "next_actions"
      ],
      "properties": {
        "kind": {
          "const": "result"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "action": {
          "type": "string"
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "awaiting_external",
            "awaiting_review",
            "succeeded",
            "failed_retryable",
            "failed_terminal",
            "cancelled"
          ]
        },
        "result": {
          "type": [
            "object",
            "null"
          ]
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assetRef"
          }
        },
        "audit_tick_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retry": {
          "type": [
            "object",
            "null"
          ]
        },
        "resume_cursor": {}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "run_id",
        "sequence",
        "event_type",
        "at",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "event"
        },
        "run_id": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "event_type": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}
