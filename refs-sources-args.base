filters:
  or:
    - 'file.inFolder("Antykathera-Essay-Work/essay-workshop/sources-texts-references/source-bank")'
    - 'file.inFolder("Antykathera-Essay-Work/essay-workshop/sources-texts-references/reference-notes")'
    - 'file.inFolder("Antykathera-Essay-Work/essay-workshop/nodes/sections")'
    - 'file.inFolder("Antykathera-Essay-Work/essay-workshop/nodes/arguments")'
    - 'file.inFolder("Antykathera-Essay-Work/essay-workshop/nodes/paths")'
    - 'file.path == "Antykathera-Essay-Work/essay-workshop/the-return-of-zero-central-plan.md"'
    - 'file.path == "Antykathera-Essay-Work/essay-workshop/agentworld-response-matrix.md"'
    - 'file.path == "Antykathera-Essay-Work/essay-workshop/sources-texts-references/10-7-2026-core-theorems-pithy.md"'
    - 'file.path == "Antykathera-Essay-Work/essay-workshop/sources-texts-references/QL-Essay-Rewrite.md"'
    - 'file.path == "Antykathera-Essay-Work/essay-workshop/sources-texts-references/claude-fable-full-chat-end-12-7-2026.md"'
    - 'file.path == "Antykathera-Essay-Work/antykathera-resources/Antikythera Agentworld Brief.md"'
    - 'file.path == "definition-of-god-working/The Definition of God — Draft 3.md"'
    - 'file.path == "definition-of-god-working/revision-notes-trust-and-f-blocks.md"'
    - 'file.path == "epi-logos-plugin-resources-copy-10-07/resources/updated-ql-mef/non-dual-binary/canonical-candidate/file-one-definitional.md"'
    - 'file.path == "epi-logos-plugin-resources-copy-10-07/resources/updated-ql-mef/non-dual-binary/canonical-candidate/file-two-processual.md"'
    - 'file.path == "epi-logos-plugin-resources-copy-10-07/resources/updated-ql-mef/non-dual-binary/canonical-candidate/file-three-quilting.md"'
    - 'file.path == "epi-logos-plugin-resources-copy-10-07/resources/updated-ql-mef/non-dual-binary/canonical-candidate/file-four-musical-epistemic.md"'
    - 'file.path == "epi-logos-plugin-resources-copy-10-07/resources/updated-ql-mef/non-dual-binary/ql-musical-derivation-v3.md"'
    - 'file.path == "epi-logos-plugin-resources-copy-10-07/resources/updated-ql-mef/mef-12-lenses-sublens-reference.md"'
    - 'file.path == "sym-dia-ballein-views.html"'
formulas:
  planning_role: 'if(status == "central-governing-plan", "central plan", if(page_type == "source-study-dossier", "source study", if(node_type == "source-record", "source record", if(page_type == "source-bank-protocol", "source protocol", if(page_type == "source-bank-index", "source index", if(page_type == "source-consumption-matrix", "source matrix", if(page_type == "granular-source-map", "granular source map", if(page_type == "source-intake-queue", "source intake", if(page_type == "research-intake-inbox", "research inbox", if(page_type == "quote-ledger", "quote ledger", if(page_type == "working-bibliography", "bibliography", if(page_type == "deprecation-manifest", "deprecation manifest", if(page_type == "section-movement", "section movement", if(page_type == "argument-path", "traversal", if(file.inFolder("Antykathera-Essay-Work/essay-workshop/nodes/arguments"), "argument", if(page_type == "argument-map", "response map", if(node_type == "reference", "legacy reference node", if(file.ext == "html", "artifact", "source corpus"))))))))))))))))))'
  readiness: 'if(node_type == "source-record", if(quote_status == "quotation-ready", "quotation-ready", citation_status), if(verification_status == "verified", "ready", if(verification_status, verification_status, if(evidence_status, evidence_status, source_status))))'
  source_state: 'if(node_type == "source-record", citation_status + " · " + quote_status, "")'
properties:
  formula.planning_role:
    displayName: Role
  formula.readiness:
    displayName: Readiness
  formula.source_state:
    displayName: Source state
  source_id:
    displayName: Source ID
  record_type:
    displayName: Record type
  source_role:
    displayName: Source role
  metadata_status:
    displayName: Metadata
  edition_status:
    displayName: Edition
  citation_status:
    displayName: Citation
  quote_status:
    displayName: Quotations
  chicago_ready:
    displayName: Chicago forms
  consumed_by_sections:
    displayName: Consuming sections
  consumed_by_arguments:
    displayName: Consuming arguments
  lifecycle_status:
    displayName: Lifecycle
  reference_kind:
    displayName: Kind
  source_status:
    displayName: Evidence
  verification_status:
    displayName: Verification
  station:
    displayName: Station
  position:
    displayName: QL position
  sequence:
    displayName: Sequence
  claim_status:
    displayName: Claim status
  evidence_status:
    displayName: Evidence status
  argument_level:
    displayName: Argument level
  argument_weight:
    displayName: Weight
  argument_role:
    displayName: Argument role
  study_status:
    displayName: Study state
  movement_ids:
    displayName: Movement consumers
  main_source_for:
    displayName: Main source for
views:
  - type: table
    name: Main source study dossiers
    filters:
      and:
        - 'page_type == "source-study-dossier"'
    order:
      - source_id
      - study_status
      - citation_status
      - quote_status
      - movement_ids
      - file.name
  - type: table
    name: Governing layer
    filters:
      or:
        - 'status == "central-governing-plan"'
        - 'page_type == "argument-map"'
        - 'page_type == "argument-path"'
    order:
      - formula.planning_role
      - formula.readiness
      - file.name
  - type: table
    name: Primary corpus and artifact
    filters:
      or:
        - 'formula.planning_role == "source corpus"'
        - 'formula.planning_role == "artifact"'
    order:
      - formula.planning_role
      - formula.readiness
      - file.name
  - type: table
    name: Scholarly source bank
    filters:
      and:
        - 'node_type == "source-record"'
    order:
      - source_id
      - record_type
      - source_role
      - metadata_status
      - edition_status
      - citation_status
      - quote_status
      - consumed_by_sections
      - file.name
  - type: table
    name: Citation-ready sources
    filters:
      and:
        - 'node_type == "source-record"'
        - 'citation_status == "citation-ready"'
    order:
      - source_id
      - record_type
      - quote_status
      - consumed_by_sections
      - consumed_by_arguments
      - file.name
  - type: table
    name: Quote acquisition
    filters:
      and:
        - 'node_type == "source-record"'
        - or:
            - 'quote_status == "locator-needed"'
            - 'quote_status == "excerpts-unverified"'
            - 'quote_status == "no-excerpts"'
    order:
      - quote_status
      - citation_status
      - source_id
      - consumed_by_sections
      - consumed_by_arguments
      - file.name
  - type: table
    name: Edition and metadata blockers
    filters:
      and:
        - 'node_type == "source-record"'
        - or:
            - 'edition_status == "needed"'
            - 'metadata_status == "partial"'
            - 'metadata_status == "unresolved"'
            - 'citation_status == "intake"'
    order:
      - metadata_status
      - edition_status
      - citation_status
      - source_id
      - consumed_by_sections
      - file.name
  - type: table
    name: Internal derivation corpus
    filters:
      and:
        - 'node_type == "source-record"'
        - 'file.hasTag("source-bank/internal-corpus")'
    order:
      - source_id
      - source_role
      - consumed_by_sections
      - consumed_by_arguments
      - file.name
  - type: table
    name: Source-bank controls
    filters:
      or:
        - 'page_type == "source-bank-protocol"'
        - 'page_type == "source-bank-index"'
        - 'page_type == "source-consumption-matrix"'
        - 'page_type == "granular-source-map"'
        - 'page_type == "source-intake-queue"'
        - 'page_type == "research-intake-inbox"'
        - 'page_type == "quote-ledger"'
        - 'page_type == "working-bibliography"'
        - 'page_type == "deprecation-manifest"'
    order:
      - formula.planning_role
      - status
      - file.name
  - type: table
    name: 48-section sequence
    filters:
      and:
        - 'page_type == "section-movement"'
    order:
      - sequence
      - station
      - position
      - claim_status
      - evidence_status
      - file.name
  - type: table
    name: §1 Return of Zero
    filters:
      and:
        - 'page_type == "section-movement"'
        - 'station == "§1"'
    order:
      - sequence
      - position
      - claim_status
      - evidence_status
      - file.name
  - type: table
    name: §2 Two Logics
    filters:
      and:
        - 'page_type == "section-movement"'
        - 'station == "§2"'
    order:
      - sequence
      - position
      - claim_status
      - evidence_status
      - file.name
  - type: table
    name: §3 Mathematical Proof Spine
    filters:
      and:
        - 'page_type == "section-movement"'
        - 'station == "§3"'
    order:
      - sequence
      - position
      - claim_status
      - evidence_status
      - file.name
  - type: table
    name: Cross-section arguments
    filters:
      and:
        - 'file.inFolder("Antykathera-Essay-Work/essay-workshop/nodes/arguments")'
    order:
      - argument_weight
      - argument_level
      - argument_role
      - claim_status
      - evidence_status
      - file.name
  - type: table
    name: Core derivation spine
    filters:
      and:
        - 'file.inFolder("Antykathera-Essay-Work/essay-workshop/nodes/arguments")'
        - 'argument_weight >= 4'
    order:
      - argument_weight
      - argument_role
      - claim_status
      - evidence_status
      - file.name
  - type: table
    name: Supportive disclosures
    filters:
      and:
        - 'file.inFolder("Antykathera-Essay-Work/essay-workshop/nodes/arguments")'
        - 'argument_weight <= 2'
    order:
      - argument_weight
      - argument_role
      - claim_status
      - evidence_status
      - file.name
  - type: table
    name: Formal-limit lineage
    filters:
      and:
        - 'file.hasTag("argument-map/formal-limit")'
    order:
      - file.name
      - source_status
      - verification_status
  - type: table
    name: Complex dynamism
    filters:
      and:
        - 'file.hasTag("argument-map/complex-dynamism")'
    order:
      - file.name
      - source_status
      - verification_status
  - type: table
    name: Agentworld response
    filters:
      and:
        - 'file.hasTag("argument-map/agentworld")'
    order:
      - file.name
      - source_status
      - verification_status
  - type: table
    name: Individuation and phenomenology
    filters:
      and:
        - 'file.hasTag("argument-map/individuation")'
    order:
      - formula.planning_role
      - claim_status
      - formula.readiness
      - file.name
  - type: table
    name: Musical-topological braid
    filters:
      or:
        - 'file.hasTag("argument-map/musical")'
        - 'file.hasTag("argument-map/arche-topos")'
    order:
      - formula.planning_role
      - claim_status
      - formula.readiness
      - file.name
  - type: table
    name: Bohm and dialogical return
    filters:
      or:
        - 'file.hasTag("argument-map/bohm")'
        - 'file.hasTag("argument-map/dialogue")'
    order:
      - formula.planning_role
      - claim_status
      - verification_status
      - source_status
      - file.name
  - type: table
    name: Torus and mathematical-artistic field
    filters:
      or:
        - 'file.hasTag("argument-map/torus")'
        - 'file.hasTag("argument-map/mathematical-artistic")'
    order:
      - formula.planning_role
      - claim_status
      - verification_status
      - source_status
      - file.name
  - type: table
    name: Computational process ontology
    filters:
      and:
        - 'file.hasTag("argument-map/process-ontology")'
    order:
      - formula.planning_role
      - argument_weight
      - sequence
      - station
      - position
      - claim_status
      - formula.readiness
      - file.name
  - type: table
    name: Praxis and planetary braid
    filters:
      and:
        - 'file.hasTag("argument-map/praxis")'
    order:
      - sequence
      - claim_status
      - formula.readiness
      - file.name
  - type: table
    name: Mono-Poly and Trust
    filters:
      or:
        - 'file.hasTag("argument-map/mono-poly")'
        - 'file.hasTag("argument-map/trust")'
    order:
      - formula.planning_role
      - sequence
      - station
      - claim_status
      - formula.readiness
      - file.name
  - type: table
    name: Open and pending
    filters:
      or:
        - 'verification_status == "pending"'
        - 'verification_status == "partially-verified"'
        - 'verification_status == "bibliography-pending"'
        - 'verification_status == "source-pending"'
        - 'citation_status == "intake"'
        - 'citation_status == "edition-needed"'
        - 'citation_status == "metadata-verified"'
        - 'quote_status == "excerpts-unverified"'
        - 'claim_status == "Open"'
    order:
      - formula.planning_role
      - formula.readiness
      - file.name
  - type: table
    name: Legacy reference-node deprecation
    filters:
      and:
        - 'node_type == "reference"'
        - 'file.inFolder("Antykathera-Essay-Work/essay-workshop/sources-texts-references/reference-notes")'
    order:
      - formula.planning_role
      - lifecycle_status
      - file.name
